# Copy to .env (or export these) before running in production.

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the deployment (used for the OAuth redirect + Secure cookies)
BASE_URL=http://localhost:3000

# Long random string for signing session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Port to listen on
PORT=3000

# Set to 1 to allow passwordless "dev login" (auto-on when Google OAuth isn't configured)
ALLOW_DEV_LOGIN=1

# Optional: path to the SQLite file (defaults to app/data.db)
# DB_PATH=/var/lib/hacker-times/data.db
